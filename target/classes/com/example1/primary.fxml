<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>


<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="160.0" prefWidth="300.0"
      style="-fx-background-color: #f0f7ff;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example1.PrimaryController">
   <children>
      <VBox prefWidth="300.0" spacing="10.0">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
         </padding>
         <children>

            <Label text="🔡 Томоос Жижигт" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2a7cc7;"/>

            <VBox spacing="4.0">
               <children>
                  <Label text="Input" style="-fx-text-fill: #555;"/>
                  <TextField fx:id="inputField"
                             style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #a8d0f5; -fx-padding: 4 8;"/>
               </children>
            </VBox>

            <VBox spacing="4.0">
               <children>
                  <Label text="Output" style="-fx-text-fill: #555;"/>
                  <TextField fx:id="outputField" editable="false"
                             style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #a8d0f5; -fx-background-color: #ddeeff; -fx-padding: 4 8;"/>
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</Pane>