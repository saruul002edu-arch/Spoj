<?import javafx.geometry.Insets?>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example3.PrimaryController"
      style="-fx-padding: 20;">

    <Label text="n:"/>
    <TextField fx:id="nField"/>

    <Label text="Weights (space-separated):"/>
    <TextField fx:id="weightsField"/>

    <Button text="Solve" onAction="#onSolve"/>

    <Label text="Output:"/>
    <TextField fx:id="outputField" editable="false"/>

</VBox>
