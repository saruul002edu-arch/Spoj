<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>


<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="200.0" prefWidth="220.0"
      style="-fx-background-color: #f5f0ff;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example2.PrimaryController">
   <children>
      <VBox prefHeight="200.0" prefWidth="220.0" spacing="10.0">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
         </padding>
         <children>

            <Label text="🗓 Жил → Сар" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6c3fc5;"/>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Year" prefWidth="50.0" style="-fx-text-fill: #555;"/>
                  <TextField fx:id="yearField" prefWidth="110.0"
                             style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #c9b8f0; -fx-padding: 4 8;"/>
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Month" prefWidth="50.0" style="-fx-text-fill: #555;"/>
                  <TextField fx:id="monthField" prefWidth="110.0"
                             style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #c9b8f0; -fx-padding: 4 8;"/>
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Output" prefWidth="50.0" style="-fx-text-fill: #555;"/>
                  <TextField fx:id="outputField" prefWidth="110.0" editable="false"
                             style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #c9b8f0; -fx-background-color: #ede8ff; -fx-padding: 4 8;"/>
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</Pane>