<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560" prefWidth="720" style="-fx-background-color: #FDF6FB;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rgb7020.PrimaryController">

    <!-- ══════════════ TOP HEADER ══════════════ -->
    <top>
        <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #FFFFFF;                      -fx-border-color: #F4C0D1;                      -fx-border-width: 0 0 1.5 0;">
            <padding><Insets bottom="14" left="24" right="24" top="18" /></padding>

            <HBox alignment="CENTER" spacing="10">
                <Label style="-fx-font-size: 28px;" text="🀱" />
                <Label style="-fx-font-size: 22px;                               -fx-font-weight: bold;                               -fx-text-fill: #993556;                               -fx-font-family: 'Segoe UI';" text="Даалуу Шахах" />
            </HBox>

            <Label style="-fx-font-size: 12px;                           -fx-text-fill: #C07090;                           -fx-font-family: 'Segoe UI';" text="RGB7020  ·  M×N самбар дээр 2×1 домино хамгийн ихийг байрлуул" />
        </VBox>
    </top>

    <!-- ══════════════ CENTER — board ══════════════ -->
    <center>
        <StackPane alignment="CENTER">
            <padding><Insets bottom="16" left="24" right="24" top="24" /></padding>

            <!-- Soft card behind the board -->
            <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #FFFFFF;                          -fx-background-radius: 18;                          -fx-border-color: #F4C0D1;                          -fx-border-width: 1;                          -fx-border-radius: 18;">
                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                <GridPane fx:id="boardGrid" alignment="CENTER" hgap="5" vgap="5" />
            </VBox>
        </StackPane>
    </center>

    <!-- ══════════════ BOTTOM — controls ══════════════ -->
    <bottom>
        <VBox alignment="CENTER" spacing="12" style="-fx-background-color: #FFFFFF;                      -fx-border-color: #F4C0D1;                      -fx-border-width: 1.5 0 0 0;">
            <padding><Insets bottom="20" left="32" right="32" top="16" /></padding>

            <!-- Row 1 : dimension inputs -->
            <HBox alignment="CENTER" spacing="24">

                <!-- M spinner -->
                <VBox alignment="CENTER" spacing="4">
                    <Label style="-fx-font-size: 11px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #C07090;                                   -fx-font-family: 'Segoe UI';" text="M  (мөр)" />
                    <Spinner fx:id="mSpinner" prefHeight="36" prefWidth="80" style="-fx-background-color: #FDF0F5;                                     -fx-background-radius: 10;                                     -fx-border-color: #F4C0D1;                                     -fx-border-radius: 10;                                     -fx-font-size: 15px;                                     -fx-font-family: 'Segoe UI';                                     -fx-text-fill: #993556;">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="2" max="16" min="1" />
                        </valueFactory>
                    </Spinner>
                </VBox>

                <!-- cute separator -->
                <Label style="-fx-font-size: 22px;                               -fx-text-fill: #ED93B1;                               -fx-font-weight: bold;                               -fx-padding: 14 0 0 0;" text="×" />

                <!-- N spinner -->
                <VBox alignment="CENTER" spacing="4">
                    <Label style="-fx-font-size: 11px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #C07090;                                   -fx-font-family: 'Segoe UI';" text="N  (багана)" />
                    <Spinner fx:id="nSpinner" prefHeight="36" prefWidth="80" style="-fx-background-color: #FDF0F5;                                     -fx-background-radius: 10;                                     -fx-border-color: #F4C0D1;                                     -fx-border-radius: 10;                                     -fx-font-size: 15px;                                     -fx-font-family: 'Segoe UI';                                     -fx-text-fill: #993556;">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="4" max="16" min="1" />
                        </valueFactory>
                    </Spinner>
                </VBox>
            </HBox>

            <!-- Row 2 : action buttons -->
            <HBox alignment="CENTER" spacing="12">

                <Button fx:id="solveButton" onAction="#handleSolve" prefHeight="40" prefWidth="130" style="-fx-background-color: #D4537E;                                -fx-background-radius: 12;                                -fx-text-fill: white;                                -fx-font-size: 14px;                                -fx-font-weight: bold;                                -fx-font-family: 'Segoe UI';                                -fx-cursor: hand;" text="✦  Шийд" />

                <Button fx:id="clearButton" onAction="#handleClear" prefHeight="40" prefWidth="130" style="-fx-background-color: #FDF0F5;                                -fx-background-radius: 12;                                -fx-border-color: #F4C0D1;                                -fx-border-width: 1;                                -fx-border-radius: 12;                                -fx-text-fill: #993556;                                -fx-font-size: 14px;                                -fx-font-family: 'Segoe UI';                                -fx-cursor: hand;" text="↺  Арилгах" />
            </HBox>

            <!-- Row 3 : result label -->
            <Label fx:id="resultLabel" style="-fx-font-size: 14px;                           -fx-font-weight: bold;                           -fx-text-fill: #993556;                           -fx-background-color: #FBEAF0;                           -fx-background-radius: 99;                           -fx-border-color: #ED93B1;                           -fx-border-width: 0.5;                           -fx-border-radius: 99;                           -fx-padding: 5 16 5 16;                           -fx-font-family: 'Segoe UI';" text="" />
        </VBox>
    </bottom>

</BorderPane>
